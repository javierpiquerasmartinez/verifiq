DATABASE_URL=postgres://postgres@localhost:5432/verifiq
PORT=3000
WEB_ORIGIN=http://localhost:5173
# Public URLs of the web app (links in emails) and of this API (https => secure cookies).
APP_URL=http://localhost:5173
API_URL=http://localhost:3000
# At least 32 random characters: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Without a key, emails are written to the log. The sending domain must be in Resend's EU region.
RESEND_API_KEY=
EMAIL_FROM=Verifiq <no-reply@verifiq.app>
# CIDRs of the proxies in front of the API, to read the client IP for rate limiting.
TRUSTED_PROXIES=
# Cloudflare R2 bucket with EU jurisdiction (logos, PDFs). Without them, files go to apps/api/.storage.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Verifacti account key (vfn_...) and AEAT environment (test|prod). Without the key, a fake connector
# stands in for VeriFactu. CONNECTOR_MASTER_KEY seals the issuers' keys: openssl rand -base64 32
VERIFACTI_API_KEY=
VERIFACTI_ENVIRONMENT=test
CONNECTOR_MASTER_KEY=
# Admin connection used by the integration tests to create a throwaway database.
TEST_DATABASE_URL=postgres://postgres@localhost:5432/postgres
# Optional: run the connector contract tests against the Verifacti sandbox as well. The account key
# (vfn_..., paid plan) runs the whole contract; the free test company's key (vf_test_...) the records part.
VERIFACTI_TEST_ACCOUNT_API_KEY=
VERIFACTI_TEST_ISSUER_API_KEY=
VERIFACTI_TEST_TAX_ID=
VERIFACTI_TEST_NAME=
