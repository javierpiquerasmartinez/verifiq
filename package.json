{
  "name": "verifiq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.6.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build:api": "turbo run build --filter=@verifiq/api",
    "build:web": "turbo run build --filter=@verifiq/web",
    "start:api": "pnpm --filter @verifiq/api db:migrate && pnpm --filter @verifiq/api start",
    "start:worker": "pnpm --filter @verifiq/api start:worker"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "eslint": "^10.11.0",
    "globals": "^17.0.0",
    "turbo": "^2.11.6",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0"
  }
}
